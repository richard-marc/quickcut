{
  "name": "quickcut",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "tauri": "tauri",
    "desktop": "node scripts/native.mjs dev",
    "desktop:build": "node scripts/native.mjs build",
    "desktop:check": "node scripts/native.mjs check",
    "desktop:test": "node scripts/native.mjs desktop-test",
    "media:test": "node scripts/native.mjs test",
    "media:integration": "node scripts/native.mjs test -- --ignored --nocapture",
    "tools:bundle": "node scripts/bundle-media.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.7.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
